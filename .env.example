# ============================================================
# ELIZA Mobile — variables de ambiente (desarrollo)
# Copiá este archivo a .env y ajustá los valores.
#
# IMPORTANTE (móvil): "localhost" apunta al dispositivo, NO a tu PC.
#   - iOS Simulator:      http://localhost:8080 funciona
#   - Android Emulator:   http://10.0.2.2:8080
#   - Dispositivo físico: http://<IP-LAN-de-tu-PC>:8080  (ipconfig)
#
# RECOMENDADO: usá la IP LAN en TODO (app y backend) para que el
# "iss" del token coincida con lo que valida el backend NestJS.
# ============================================================
EXPO_PUBLIC_KEYCLOAK_BASE_URL=http://192.168.1.10:8080
EXPO_PUBLIC_KEYCLOAK_REALM=eliza
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=eliza-mobile
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
