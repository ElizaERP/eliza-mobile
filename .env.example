# ============================================================
# ELIZA Mobile — variables de ambiente
# Copiá este archivo a .env (no se sube a git) y reiniciá con:
#   npm run start:clear
#
# La app solo habla con la API: el inicio de sesión también pasa por ella
# (POST /v1/auth/login). Ya no se configura Keycloak en la app.
#
# AMBIENTE DEV (VM en OCI, publicado solo dentro de la tailnet):
#   - El teléfono necesita la app Tailscale ACTIVA, con la misma cuenta.
#   - HTTPS con certificado válido de Tailscale: no hace falta permitir HTTP.
#   - API_BASE_URL incluye /api (prefijo global, sin versión).
# ============================================================
EXPO_PUBLIC_API_BASE_URL=https://eliza-dev.taile05b63.ts.net/api

# ------------------------------------------------------------
# Backend LOCAL (alternativa): usá la IP LAN de tu PC,
# porque "localhost" en el teléfono es el propio teléfono.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000/api
# ------------------------------------------------------------
